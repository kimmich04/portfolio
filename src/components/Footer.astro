---
import { SITE, SOCIALS } from '@/consts';

const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto flex max-w-3xl flex-col items-center justify-between gap-3 px-5 py-8 text-sm text-zinc-500 sm:flex-row sm:px-6">
    <p>
      &copy; {year} {SITE.name}
    </p>
    <ul class="flex gap-5">
      {SOCIALS.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
            {s.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
