---
import ThemeToggle from './ThemeToggle.astro';
import { NAV_LINKS, SITE } from '@/consts';
---

<header class="sticky top-0 z-10 border-b border-zinc-200/70 bg-white/80 backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-950/80">
  <nav class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-5 py-4 sm:px-6">
    <a href="/" class="font-semibold tracking-tight" aria-label={`${SITE.name}, home`}>
      <span class="hidden sm:inline">{SITE.name}</span>
      <span class="sm:hidden">{SITE.initials}</span>
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      <ul class="flex items-center gap-3 text-sm sm:gap-5">
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link={link.href}
              class="text-zinc-600 transition-colors hover:text-accent aria-[current=true]:font-semibold aria-[current=true]:text-accent dark:text-zinc-400"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  // Highlights the current page, and on the home page the section being read.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

  const setActive = (href: string | null) => {
    links.forEach((a) => {
      if (a.dataset.navLink === href) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
  };

  const path = window.location.pathname;
  if (path.startsWith('/projects')) {
    setActive('/projects');
  } else if (path.startsWith('/blog')) {
    setActive('/blog');
  } else if (path === '/') {
    // Home section id -> nav link it belongs to (sections not listed clear the highlight)
    const sectionToNav: Record<string, string> = {
      experience: '/#experience',
      projects: '/projects',
      blog: '/blog',
      contact: '/#contact',
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(sectionToNav[entry.target.id] ?? null);
        }
      },
      // Only the band around the middle of the viewport counts as "being read"
      { rootMargin: '-40% 0px -55% 0px' },
    );
    document.querySelectorAll('main section[id]').forEach((s) => observer.observe(s));
  }
</script>
