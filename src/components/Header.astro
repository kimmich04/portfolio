---
import ThemeToggle from './ThemeToggle.astro';
import { NAV_LINKS, SITE } from '@/consts';
---

<header class="sticky top-0 z-10 border-b border-zinc-200/70 bg-white/80 backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-950/80">
  <nav class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-5 py-4 sm:px-6">
    <a href="/" class="font-semibold tracking-tight">
      {SITE.name}
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      <ul class="flex items-center gap-3 text-sm sm:gap-5">
        {NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} class="text-zinc-600 transition-colors hover:text-accent dark:text-zinc-400">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
