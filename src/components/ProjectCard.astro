---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, company, tech, repo, demo } = project.data;
---

<article class="group rounded-xl border border-zinc-200 p-5 transition hover:-translate-y-0.5 hover:border-accent/60 hover:shadow-lg dark:border-zinc-800">
  <h3 class="text-lg font-semibold">
    <a href={`/projects/${project.id}`} class="group-hover:text-accent">
      {title}
    </a>
  </h3>
  {company && <p class="mt-1 text-xs text-zinc-500">{company}</p>}
  <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{description}</p>
  {tech.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-2">
      {tech.map((t) => (
        <li class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs dark:bg-zinc-800">{t}</li>
      ))}
    </ul>
  )}
  <div class="mt-4 flex gap-4 text-sm font-medium">
    {repo && (
      <a href={repo} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
        Code ↗
      </a>
    )}
    {demo && (
      <a href={demo} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
        Live ↗
      </a>
    )}
  </div>
</article>
