---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, company, role, badge, tech, repo, demo, links } = project.data;
const context = [company, role].filter(Boolean).join(' · ');
---

<article class="group rounded-xl border border-zinc-200 bg-white/60 p-5 backdrop-blur-sm transition dark:bg-zinc-900/50 hover:-translate-y-0.5 hover:border-accent/60 hover:shadow-lg dark:border-zinc-800">
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold">
      <a href={`/projects/${project.id}`} class="group-hover:text-accent">
        {title}
      </a>
    </h3>
    {badge && (
      <span class="shrink-0 rounded-full bg-accent/10 px-2.5 py-0.5 text-xs font-medium text-accent">{badge}</span>
    )}
  </div>
  {context && <p class="mt-1 text-xs text-zinc-500">{context}</p>}
  <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{description}</p>
  {tech.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-2">
      {tech.map((t) => (
        <li class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs dark:bg-zinc-800">{t}</li>
      ))}
    </ul>
  )}
  <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm font-medium">
    {repo && (
      <a href={repo} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
        Code ↗
      </a>
    )}
    {demo && (
      <a href={demo} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
        Live ↗
      </a>
    )}
    {links.map((link) => (
      <a href={link.href} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
        {link.label} ↗
      </a>
    ))}
  </div>
</article>
