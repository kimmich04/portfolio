---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostList from '@/components/PostList.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Blog" description="Notes on what I'm learning and building.">
  <h1 class="text-4xl font-bold tracking-tight" data-reveal>
    Blog
  </h1>
  <p class="mt-3 text-zinc-600 dark:text-zinc-400" data-reveal>
    Notes on what I'm learning and building.
  </p>
  <div class="mt-10" data-reveal>
    {posts.length > 0 ? <PostList posts={posts} /> : <p class="text-zinc-500">No posts yet.</p>}
  </div>
</BaseLayout>
