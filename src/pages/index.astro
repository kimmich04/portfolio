---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import PostList from '@/components/PostList.astro';
import { EDUCATION, EXPERIENCE, SITE, SKILLS, SOCIALS } from '@/consts';
import avatar from '@/assets/avatar.jpg';

const featuredProjects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <!-- Hero -->
  <section class="flex flex-col-reverse gap-8 py-12 sm:flex-row sm:items-center sm:justify-between sm:py-20">
    <div>
      <p class="font-medium text-accent" data-reveal>
        Hi, I'm
      </p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl" data-reveal data-reveal-delay="0.1">
        {SITE.name}
      </h1>
      <p class="mt-4 text-xl text-zinc-600 sm:text-2xl dark:text-zinc-400" data-reveal data-reveal-delay="0.2">
        {SITE.role} building production TypeScript apps across frontend and backend.
      </p>
      <p class="mt-3 text-sm text-zinc-500" data-reveal data-reveal-delay="0.25">
        {SITE.location}
      </p>
      <div class="mt-8 flex flex-wrap gap-3" data-reveal data-reveal-delay="0.3">
        <a href="/projects" class="rounded-lg bg-accent px-5 py-2.5 font-medium text-white transition hover:opacity-90">
          View my work
        </a>
        <a
          href="#contact"
          class="rounded-lg border border-zinc-300 px-5 py-2.5 font-medium transition hover:border-accent hover:text-accent dark:border-zinc-700"
        >
          Get in touch
        </a>
      </div>
    </div>
    <div data-reveal class="shrink-0">
      <Image
        src={avatar}
        alt={`Photo of ${SITE.name}`}
        width={320}
        height={320}
        loading="eager"
        class="size-32 rounded-full object-cover ring-4 ring-accent/20 sm:size-44"
      />
    </div>
  </section>

  <Section id="about" title="About">
    <div class="space-y-4 text-zinc-600 dark:text-zinc-400">
      <p>
        I'm a Software Engineer with 1+ years of experience building production JavaScript/TypeScript applications
        across frontend and backend. I've delivered reusable component libraries, secure authentication flows, and
        event-driven services at Bosch and Kenix Solution.
      </p>
      <p>
        I care about maintainable codebases: I apply SOLID principles, layered architecture and systems thinking, and I
        enjoy removing duplicated code and tracking down production issues. I'm used to working in Agile teams with
        CI/CD workflows.
      </p>
    </div>
  </Section>

  <Section id="experience" title="Experience">
    <ol class="space-y-10 border-l border-zinc-200 dark:border-zinc-800">
      {EXPERIENCE.map((job) => (
        <li class="relative pl-6">
          <span class="absolute top-1.5 -left-[5px] size-2.5 rounded-full bg-accent" aria-hidden="true"></span>
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
            <h3 class="font-semibold">{job.company}</h3>
            <span class="shrink-0 text-sm text-zinc-500">{job.period}</span>
          </div>
          <p class="text-sm text-accent">{job.role}</p>
          <ul class="mt-3 list-disc space-y-1.5 pl-4 text-sm text-zinc-600 marker:text-zinc-400 dark:text-zinc-400">
            {job.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="skills" title="Skills">
    <dl class="grid gap-6 sm:grid-cols-2">
      {Object.entries(SKILLS).map(([group, items]) => (
        <div>
          <dt class="text-sm font-semibold tracking-wide text-zinc-500 uppercase">{group}</dt>
          <dd class="mt-2 flex flex-wrap gap-2">
            {items.map((item) => (
              <span class="rounded-md border border-zinc-200 px-2.5 py-1 text-sm dark:border-zinc-800">{item}</span>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section id="projects" title="Featured projects">
    <div class="grid gap-4 sm:grid-cols-2">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
    <a href="/projects" class="mt-6 inline-block text-sm font-medium text-accent hover:underline">
      All projects →
    </a>
  </Section>

  <Section id="education" title="Education">
    <ul class="space-y-6">
      {EDUCATION.map((edu) => (
        <li>
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
            <h3 class="font-semibold">{edu.school}</h3>
            <span class="shrink-0 text-sm text-zinc-500">{edu.period}</span>
          </div>
          <p class="text-sm text-accent">{edu.degree}</p>
          <ul class="mt-2 space-y-1 text-sm text-zinc-600 dark:text-zinc-400">
            {edu.notes.map((n) => (
              <li>{n}</li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </Section>

  {recentPosts.length > 0 && (
    <Section id="blog" title="Recent writing">
      <PostList posts={recentPosts} />
      <a href="/blog" class="mt-6 inline-block text-sm font-medium text-accent hover:underline">
        All posts →
      </a>
    </Section>
  )}

  <Section id="contact" title="Contact">
    <p class="text-zinc-600 dark:text-zinc-400">I'm open to new opportunities. The best way to reach me is by email:</p>
    <a
      href={`mailto:${SITE.email}`}
      class="mt-3 inline-block text-lg font-semibold break-all text-accent hover:underline"
    >
      {SITE.email}
    </a>
    <ul class="mt-6 flex gap-5 text-sm">
      {SOCIALS.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
            {s.label} ↗
          </a>
        </li>
      ))}
    </ul>
  </Section>
</BaseLayout>
