---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, company, period, tech, repo, demo } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={description}>
  <article>
    <a href="/projects" class="text-sm text-zinc-500 hover:text-accent">
      ← All projects
    </a>
    <header class="mt-6 mb-10" data-reveal>
      <h1 class="text-4xl font-bold tracking-tight">{title}</h1>
      <p class="mt-3 text-lg text-zinc-600 dark:text-zinc-400">{description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-zinc-500">
        {company && <span>{company}</span>}
        <span>{period}</span>
        {tech.length > 0 && <span>{tech.join(' · ')}</span>}
      </div>
      <div class="mt-4 flex gap-4 text-sm font-medium">
        {repo && (
          <a href={repo} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
            Code ↗
          </a>
        )}
        {demo && (
          <a href={demo} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
            Live ↗
          </a>
        )}
      </div>
    </header>
    <div class="prose prose-zinc max-w-none dark:prose-invert">
      <Content />
    </div>
  </article>
</BaseLayout>
